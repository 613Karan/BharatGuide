# Copy to .env (gitignored) and fill in. Leave both unset to use local Docker.
#
# Qdrant Cloud: Cluster Detail page -> copy the cluster URL, keep port 6333.
QDRANT_URL=https://YOUR-CLUSTER-ID.YOUR-REGION.YOUR-PROVIDER.cloud.qdrant.io:6333
# Cluster Detail page -> API Keys -> Create. Shown only once.
QDRANT_API_KEY=
